def test_click_completion_path_uses_context_for_zuliprc_and_stream(
    monkeypatch,
):
    client = MagicMock()
    client.get_stream_id.return_value = {
        "result": "success",
        "stream_id": 17,
    }
    client.get_stream_topics.return_value = {
        "result": "success",
        "topics": [
            {"name": "Announcements"},
            {"name": "Lab 1"},
        ],
    }
    seen = {}

    def get_client(zuliprc=None):
        seen["zuliprc"] = zuliprc
        return client

    monkeypatch.setattr(cli.zulipcli, "get_client", get_client)

    command = get_command(app)
    context = _resolve_context(
        command,
        {},
        "zulipcli",
        [
            "--zuliprc",
            "/tmp/custom.zuliprc",
            "send",
            "--stream",
            "general",
            "--topic",
        ],
    )
    obj, incomplete = _resolve_incomplete(
        context,
        [
            "--zuliprc",
            "/tmp/custom.zuliprc",
            "send",
            "--stream",
            "general",
            "--topic",
        ],
        "A",
    )

    completions = obj.shell_complete(context, incomplete)

    assert [item.value for item in completions] == ["Announcements"]
    assert seen["zuliprc"] == "/tmp/custom.zuliprc"
