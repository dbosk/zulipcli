            "found_newest": False,
            "messages": [
                _make_stream_message(
                    3,
                    60,
                    "Alice Admin",
                    "release planning",
                    "First message",
                ),
            ],
        },
        {
            "result": "success",
            "found_newest": True,
            "messages": [
                _make_stream_message(
                    4,
                    120,
                    "Bob Builder",
                    "release planning",
                    "Second message",
                ),
            ],
        },
    ]
    requests = []

    def get_messages(request):
        requests.append(copy.deepcopy(request))
        return responses[len(requests) - 1]

    client = MagicMock()
    client.get_messages.side_effect = get_messages
    args = SimpleNamespace(
        stream="general",
        topic="release planning",
        unread=False,
        mark_as_read=False,
    )
    monkeypatch.setattr(cli, "_stdout_is_tty", lambda: False)
    read_command(client, args)

    assert requests[0] == {
        "anchor": 0,
        "num_before": 0,
        "num_after": HISTORY_BATCH_SIZE,
        "narrow": [
            {"operator": "stream", "operand": "general"},
            {"operator": "topic", "operand": "release planning"},
        ],
        "client_gravatar": False,
        "apply_markdown": False,
    }
    assert requests[1]["anchor"] == 4
    assert requests[1]["narrow"] == requests[0]["narrow"]
    output = capsys.readouterr().out
    assert output == (
        "1970-01-01T00:01:00Z\tAlice Admin\trelease planning\n"
        "First message\n\n"
        "1970-01-01T00:02:00Z\tBob Builder\trelease planning\n"
        "Second message\n\n"
    )
