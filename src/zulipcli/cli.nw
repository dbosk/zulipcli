When a member's Zulip email and delivery email are the same string
(the common shape for bots), the prefix must not produce two
identical candidates---the shell would just show the same row twice.

<<test functions>>=
def test_user_completion_dedupes_identical_values(monkeypatch):
    client = MagicMock()
    client.get_users.return_value = {
        "result": "success",
        "members": [
            {
                "full_name": "Q Bot",
                "email": "q-bot@example.zulipchat.com",
                "delivery_email": "q-bot@example.zulipchat.com",
                "is_active": True,
            },
        ],
    }
    monkeypatch.setattr(
        cli.zulipcli,
        "get_client",
        lambda zuliprc=None: client,
    )

    assert complete_user_emails(
        SimpleNamespace(find_root=lambda: SimpleNamespace(params={})),
        "q",
    ) == [
        ("Q Bot", "q-bot@example.zulipchat.com"),
        ("q-bot@example.zulipchat.com", "Q Bot"),
    ]
