    def explode(client):
        raise sqlite3.OperationalError("unable to open database")

    monkeypatch.setattr(cli, "_term_index_connection", explode)

    cli._index_messages_safely(
        _make_indexing_client(),
        [{"id": 1, "content": "migration"}],
    )
@

<<test functions>>=
