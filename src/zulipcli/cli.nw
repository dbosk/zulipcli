one user should emit three candidates for that user---one per
matching field---so bash (which cannot show help text) still surfaces
every usable form of the recipient identifier.

<<test functions>>=
def test_user_completion_emits_one_candidate_per_matching_field(
    monkeypatch,
):
    client = MagicMock()
    client.get_users.return_value = {
        "result": "success",
        "members": [
            {
                "full_name": "Alice Admin",
                "email": "alice@example.com",
                "delivery_email": "alice.admin@corp.example",
                "is_active": True,
            },
            {
                "full_name": "Bob Bot",
                "email": "bot@example.com",
                "delivery_email": None,
                "is_active": False,
            },
        ],
    }
    monkeypatch.setattr(
        cli.zulipcli,
        "get_client",
        lambda zuliprc=None: client,
    )

    assert complete_user_emails(
        SimpleNamespace(find_root=lambda: SimpleNamespace(params={})),
        "ali",
    ) == [
        ("Alice Admin", "alice@example.com"),
        ("alice@example.com", "Alice Admin"),
        ("alice.admin@corp.example", "Alice Admin"),
    ]
@

A prefix that only matches the name (not the Zulip email) is the
crucial bash case; the single candidate returned must be the name
itself.

<<test functions>>=
def test_user_completion_returns_full_name_for_name_only_prefix(
    monkeypatch,
):
    client = MagicMock()
    client.get_users.return_value = {
        "result": "success",
        "members": [
            {
                "full_name": "Daniel Bosk",
                "email": "user1054485@example.zulipchat.com",
                "delivery_email": None,
                "is_active": True,
            },
        ],
    }
    monkeypatch.setattr(
        cli.zulipcli,
        "get_client",
        lambda zuliprc=None: client,
    )

    assert complete_user_emails(
        SimpleNamespace(find_root=lambda: SimpleNamespace(params={})),
        "Dan",
    ) == [("Daniel Bosk", "user1054485@example.zulipchat.com")]
