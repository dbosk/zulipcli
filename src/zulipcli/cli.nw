        return {"result": "success"}

    def run_worker(command, *, input, text):
        runs.append({
            "command": list(command),
            "input": input,
            "text": text,
        })
        return SimpleNamespace(returncode=0)

    monkeypatch.setattr(cli.subprocess, "run", run_worker)
    client.update_message_flags.side_effect = update_message_flags

    with pytest.raises(KeyboardInterrupt):
        cli.bot_command(
            client,
            SimpleNamespace(
                command=["worker"],
                stdin_format=cli.BotStdinFormat.read,
            ),
        )

    assert runs == [{
        "command": ["worker"],
        "input": cli._bot_messages_to_stdin(
            messages,
            cli.BotStdinFormat.read,
        ),
        "text": True,
    }]
    assert marked == [
        {"messages": [1], "op": "add", "flag": "read"},
    ]
    assert client.register.call_count == 2
    client.deregister.assert_called_once_with("queue-2")
@

\section{Registering the command surface}
\label{sec:registration}

The standalone and embedded applications must expose the same command
surface.
We therefore register the handlers through one helper that binds the
shared command implementations to whichever [[typer.Typer]] instance
we are constructing.
The [[users]] group is attached with [[add_typer]] so its three
subcommands ride along; the remaining verbs stay flat.

<<functions>>=
def _register_commands(target: typer.Typer) -> None:
    """Register Zulip subcommands on `target`."""
    target.add_typer(users_app, name="users")
    target.command("send")(_send_handler)
    target.command("dm")(_dm_handler)
    target.command("streams")(_streams_handler)
    target.command("topics")(_topics_handler)
    target.command("read")(_read_handler)
    target.command("search")(_search_handler)
    target.command("terms")(_terms_handler)
    target.command(
        "bot",
        context_settings=BOT_CONTEXT_SETTINGS,
        epilog=BOT_HELP_EPILOG,
    )(_bot_handler)
@

<<functions>>=
_register_commands(app)
@

\section{The shared message-reading engine}
\label{sec:reading-engine}

The header needs to stay readable for both stream history and direct
messages.
We therefore print a UTC timestamp and sender on the first line, plus a
third column that is either the stream topic or the DM conversation's
participant set.
For the message body we keep Zulip's raw Markdown when stdout is not a
TTY, so pipes and redirections receive exactly the source text.
Interactive terminals can do better, and [[rich]] is now a required
dependency, so we always render Markdown locally in that case.
Using [[apply_markdown=False]] keeps both output modes based on the same
Markdown source instead of rendered HTML.

Separating terminal detection from body rendering keeps
[[_print_read_message()]] focused on record formatting.
It also makes the two output modes easy to verify in tests: raw piped
output and rich rendering on a TTY.

The bot's worker-stdin payload adds one more consumer for the plain text
form.
That payload must exactly match the non-interactive [[read]] output, but
it needs to be written into an in-memory buffer rather than directly to
stdout.
We therefore factor the plain formatter into file-oriented helpers and
keep the Rich/TTY path only for direct terminal printing.

<<functions>>=
def _stdout_is_tty():
    """Return whether stdout is an interactive terminal."""
    isatty = getattr(sys.stdout, "isatty", None)
    return bool(isatty and isatty())
@

<<functions>>=
def _write_read_content(file, content):
    """Write raw read-command content to `file`."""
    print(content, file=file)
@

<<functions>>=
def _print_read_content(content):
    """Print Markdown content for the current stdout."""
    if _stdout_is_tty():
        Console(file=sys.stdout).print(Markdown(content))
    else:
        _write_read_content(sys.stdout, content)
@

<<functions>>=
def _read_message_target(message):
    """Return the topic or DM participant label for one message."""
    if message.get("type") == "private":
        recipients = message.get("display_recipient")
        if isinstance(recipients, list):
            return ", ".join(
                recipient["full_name"]
                for recipient in sorted(
                    recipients,
                    key=lambda recipient: recipient["full_name"],
                )
            )
    return message.get("topic") or message.get("subject", "")
@

The timestamp gains a third consumer in \cref{sec:search}, and three
copies of one [[strftime]] call is two too many.
Plain [[read]] output, the bot's worker payload, and a search hit have
to agree exactly, or a tool that learns to parse one will mis-parse
another.
Formatting in UTC rather than local time keeps that agreement stable
across machines and daylight-saving boundaries.

<<constants>>=
MESSAGE_TIMESTAMP_FORMAT = "%Y-%m-%dT%H:%M:%SZ"
<<functions>>=
def _format_message_timestamp(message):
    """Return one message's UTC timestamp in the shared format."""
    return datetime.fromtimestamp(
        message["timestamp"],
        timezone.utc,
    ).strftime(MESSAGE_TIMESTAMP_FORMAT)
@

<<functions>>=
def _write_read_message(file, message):
    """Write one message in the plain read-command format."""
    timestamp = _format_message_timestamp(message)
    target = _read_message_target(message)
    print(
        f"{timestamp}\t{message['sender_full_name']}\t{target}",
        file=file,
    )
    _write_read_content(file, message["content"])
    print(file=file)
@

<<functions>>=
def _print_read_message(message):
    """Print one message in the read command format."""
    if _stdout_is_tty():
        timestamp = _format_message_timestamp(message)
        target = _read_message_target(message)
        print(f"{timestamp}\t{message['sender_full_name']}\t{target}")
        _print_read_content(message["content"])
        print()
    else:
        _write_read_message(sys.stdout, message)
@

The request stays constant across pages except for the anchor.
Each successful batch is printed immediately, and then the anchor moves
to one past the last message ID we have already seen.
If the caller asked to mark messages as read, we defer that update until
after every page has been printed successfully.

That loop does not care whether the narrow points at a stream or a DM
conversation, so [[read]] and [[dm]] share one helper that accepts the
already-constructed narrow.

The bare [[read -U]] case needs one extra wrinkle.
Without a stream filter, Zulip's plain [[is:unread]] narrow only covers
the account's personal history, while the bot now also watches unread
messages in shared public-channel history.
To keep the worker-facing [[read -U]] command aligned with the bot's
trigger condition, we read those two scopes separately and merge them.

Several callers need the same acknowledgement step once a batch of
messages has been handled successfully.
Keeping that flag update in one helper ensures [[read]] and [[bot]] both
add the same [[read]] flag in the same way.

<<functions>>=
def _mark_message_ids_as_read(client, message_ids):
    """Mark the given message IDs as read when the batch is non-empty."""
    if message_ids:
        _require_success(client.update_message_flags({
            "messages": list(message_ids),
            "op": "add",
            "flag": "read",
        }))
@

<<functions>>=
def _read_messages(client, narrow, *, mark_as_read):
    """Read all messages matching `narrow` from oldest to newest."""
    request = _history_request(narrow)

    printed_message_ids = [] if mark_as_read else None
    found_newest = False
    while not found_newest:
        result = _fetch_history_page(client, request)

        found_newest = result["found_newest"]
        if result["messages"]:
            for message in result["messages"]:
                _print_read_message(message)
                if printed_message_ids is not None:
                    printed_message_ids.append(message["id"])
            request["anchor"] = result["messages"][-1]["id"] + 1

    _mark_message_ids_as_read(client, printed_message_ids)
@

<<functions>>=
def read_command(client, args):
    """Read messages from a stream or topic."""
    if args.unread and not args.stream:
        messages = sorted(
            _get_all_visible_unread_messages(client),
            key=lambda message: message["id"],
        )
        for message in messages:
            _print_read_message(message)
        if args.mark_as_read:
            _mark_message_ids_as_read(
                client,
                [message["id"] for message in messages],
            )
        return

    narrow = []
    if args.stream:
        narrow.append(
            {"operator": "stream", "operand": args.stream}
        )
    if args.topic and args.stream:
        narrow.append(
            {"operator": "topic", "operand": args.topic}
        )
    if args.unread:
        narrow.append(
            {"operator": "is", "operand": "unread"}
        )
    _read_messages(client, narrow, mark_as_read=args.mark_as_read)
@

